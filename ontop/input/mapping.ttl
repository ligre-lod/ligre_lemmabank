##############
# LEMMA: gender mapping
##############
:LEMMA-GENDER-MASC
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id_lemma FROM lemma
        WHERE gen IN ('m', '1', '2', '*') AND upostag IN ('NOUN', 'PROPN')
    """ ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/lemma/{id_lemma}" ] ;
    rr:predicateObjectMap [ rr:predicate ligre:hasGender ;
                            rr:objectMap [ rr:constant ligre:masculine ] ] .

:LEMMA-GENDER-FEM
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id_lemma FROM lemma
        WHERE gen IN ('f', '2', '*') AND upostag IN ('NOUN', 'PROPN')
    """ ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/lemma/{id_lemma}" ] ;
    rr:predicateObjectMap [ rr:predicate ligre:hasGender ;
                            rr:objectMap [ rr:constant ligre:feminine ] ] .

:LEMMA-GENDER-NEUT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id_lemma FROM lemma
        WHERE gen IN ('n', '1', '*') AND upostag IN ('NOUN', 'PROPN')
    """ ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/lemma/{id_lemma}" ] ;
    rr:predicateObjectMap [ rr:predicate ligre:hasGender ;
                            rr:objectMap [ rr:constant ligre:neuter ] ] .

##############
# DOCUMENT (from corpus_document, loaded from CoNLL-U by database/load_conllu.py)
##############

:DOCUMENT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_document, doc_id FROM corpus_document""" ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/document/{id_document}" ;
                            rr:class    ligre:Document ] ;
    rr:predicateObjectMap [ rr:predicate dcterms:identifier ;
                            rr:objectMap [ rr:column   "doc_id" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "doc_id" ;
                                           rr:datatype xsd:string ] ] .

##############
# SENTENCE (from corpus_sentence)
##############

:SENTENCE
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_sentence, id_document, sent_id, sent_index, text FROM corpus_sentence""" ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/sentence/{id_sentence}" ;
                            rr:class    ligre:Sentence ] ;
    rr:predicateObjectMap [ rr:predicate dcterms:identifier ;
                            rr:objectMap [ rr:column   "sent_id" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "text" ;
                                           rr:language "grc" ] ] ;
    rr:predicateObjectMap [ rr:predicate ligre:sentenceIndex ;
                            rr:objectMap [ rr:column   "sent_index" ;
                                           rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ligre:inDocument ;
                            rr:objectMap [ rr:template "http://ligre-erc.eu/data/id/document/{id_document}" ] ] .

##############
# TOKEN (core fields, from corpus_token)
##############

:TOKEN
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_token, id_sentence, token_order, form FROM corpus_token""" ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/token/{id_token}" ;
                            rr:class    ligre:Token ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "form" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate ontolex:writtenRep ;
                            rr:objectMap [ rr:column   "form" ;
                                           rr:language "grc" ] ] ;
    rr:predicateObjectMap [ rr:predicate ligre:tokenOrder ;
                            rr:objectMap [ rr:column   "token_order" ;
                                           rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate ligre:inSentence ;
                            rr:objectMap [ rr:template "http://ligre-erc.eu/data/id/sentence/{id_sentence}" ] ] .

##############
# TOKEN: dependency relation and syntactic head
##############

:TOKEN-DEPREL
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_token, deprel FROM corpus_token WHERE deprel IS NOT NULL""" ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/token/{id_token}" ] ;
    rr:predicateObjectMap [ rr:predicate ligre:hasDeprel ;
                            rr:objectMap [ rr:column   "deprel" ;
                                           rr:datatype xsd:string ] ] .

:TOKEN-HEAD
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_token, id_head_token FROM corpus_token WHERE id_head_token IS NOT NULL""" ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/token/{id_token}" ] ;
    rr:predicateObjectMap [ rr:predicate ligre:hasHead ;
                            rr:objectMap [ rr:template "http://ligre-erc.eu/data/id/token/{id_head_token}" ] ] .

##############
# TOKEN: link to lemma
# Reuses lila:hasLemma (see lila.owl) -- the property LiLa itself defines to link
# corpus tokens to lemma resources -- applied here to our own token/lemma IRIs, the
# same way the LiLa Latin corpora link powla:Terminal tokens to lilaLemma: resources.
##############

:TOKEN-LEMMA
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_token, id_lemma FROM corpus_token WHERE id_lemma IS NOT NULL""" ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/token/{id_token}" ] ;
    rr:predicateObjectMap [ rr:predicate lila:hasLemma ;
                            rr:objectMap [ rr:template "http://ligre-erc.eu/data/id/lemma/{id_lemma}" ] ] .

##############
# TOKEN: XPOS (treebank-specific POS tag, kept as a plain literal since it has
# no fixed vocabulary of individuals like UPOS does)
##############

:TOKEN-XPOS
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_token, xpos FROM corpus_token WHERE xpos IS NOT NULL""" ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/token/{id_token}" ] ;
    rr:predicateObjectMap [ rr:predicate ligre:hasXPOS ;
                            rr:objectMap [ rr:column   "xpos" ;
                                           rr:datatype xsd:string ] ] .

