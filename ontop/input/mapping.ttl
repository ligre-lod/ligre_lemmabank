# R2RML mapping from the ligre_db `lemma` table to RDF.

@prefix :        <http://ligre-erc.eu/data/id/lemma/> .
@prefix ligre:   <http://ligre-erc.eu/ontologies/ligre/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rr:      <http://www.w3.org/ns/r2rml#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix lila:    <http://lila-erc.eu/ontologies/lila/> .

##############
# LEMMA (core fields)
##############

:LEMMA
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_lemma, label FROM lemma""" ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/lemma/{id_lemma}" ;
                            rr:class    ligre:Lemma ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "label" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate ontolex:writtenRep ;
                            rr:objectMap [ rr:column   "label" ;
                                           rr:language "grc" ] ] ;
    rr:predicateObjectMap [ rr:predicate dcterms:isPartOf ;
                            rr:objectMap [ rr:constant <http://ligre-erc.eu/data/id/lemma/LemmaBank> ] ] .

##############
# LEMMA: written representation variants (from lemma_wr, incl. the canonical
# label itself -- see dataloader/generate_lemma_data.py). Adds one extra
# ontolex:writtenRep triple per row on the same lemma subject as :LEMMA.
##############

:LEMMA-WR
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_lemma, wr FROM lemma_wr""" ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/lemma/{id_lemma}" ] ;
    rr:predicateObjectMap [ rr:predicate ontolex:writtenRep ;
                            rr:objectMap [ rr:column   "wr" ;
                                           rr:language "grc" ] ] .

##############
