##############
# LEMMA: gender mapping
##############
:LEMMA-GENDER-MASC
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id_lemma FROM lemma
        WHERE gen IN ('m', '1', '2', '*') AND upostag IN ('NOUN', 'PROPN')
    """ ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/lemma/{id_lemma}" ] ;
    rr:predicateObjectMap [ rr:predicate ligre:hasGender ;
                            rr:objectMap [ rr:constant ligre:masculine ] ] .

:LEMMA-GENDER-FEM
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id_lemma FROM lemma
        WHERE gen IN ('f', '2', '*') AND upostag IN ('NOUN', 'PROPN')
    """ ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/lemma/{id_lemma}" ] ;
    rr:predicateObjectMap [ rr:predicate ligre:hasGender ;
                            rr:objectMap [ rr:constant ligre:feminine ] ] .

:LEMMA-GENDER-NEUT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """
        SELECT id_lemma FROM lemma
        WHERE gen IN ('n', '1', '*') AND upostag IN ('NOUN', 'PROPN')
    """ ] ;
    rr:subjectMap         [ rr:template "http://ligre-erc.eu/data/id/lemma/{id_lemma}" ] ;
    rr:predicateObjectMap [ rr:predicate ligre:hasGender ;
                            rr:objectMap [ rr:constant ligre:neuter ] ] .
