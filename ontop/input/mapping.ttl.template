lemma:LEMMA
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_lemma, label FROM lemma""" ] ;
    rr:subjectMap         [ rr:template "__LIGRE_BASE_URL__/data/id/lemma/{id_lemma}" ;
                            rr:class    lila:Lemma ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "label" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate ontolex:writtenRep ;
                            rr:objectMap [ rr:column   "label" ;
                                           rr:language "grc" ] ] ;
    rr:predicateObjectMap [ rr:predicate dcterms:isPartOf ;
                            rr:objectMap [ rr:constant lemma:LemmaBank ] ] .

