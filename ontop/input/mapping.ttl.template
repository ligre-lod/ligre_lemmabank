@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rr:      <http://www.w3.org/ns/r2rml#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix lila:    <http://lila-erc.eu/ontologies/lila/> .
@prefix lemma:   <__LIGRE_BASE_URL__/data/id/lemma/> .

lemma:LEMMA
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT id_lemma, label FROM lemma""" ] ;
    rr:subjectMap         [ rr:template "__LIGRE_BASE_URL__/data/id/lemma/{id_lemma}" ;
                            rr:class    lila:Lemma ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column   "label" ;
                                           rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate ontolex:writtenRep ;
                            rr:objectMap [ rr:column   "label" ;
                                           rr:language "grc" ] ] ;
    rr:predicateObjectMap [ rr:predicate dcterms:isPartOf ;
                            rr:objectMap [ rr:constant lemma:LemmaBank ] ] .

