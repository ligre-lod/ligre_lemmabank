corpus:UNIT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT CAST(iri AS TEXT) AS iri, label, ref_type, cit_level, ref_value, CAST(first_iri AS TEXT) AS first_iri, CAST(last_iri AS TEXT) AS last_iri, CAST(next_iri AS TEXT) AS next_iri FROM corpus.citation_unit""" ] ;
    rr:subjectMap         [ rr:column "iri" ;
                            rr:class    lila_corpus:citationUnit ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
                            rr:objectMap [ rr:column "label" ] ] ;
    rr:predicateObjectMap [ rr:predicate lila_corpus:hasRefType ;
                            rr:objectMap [ rr:column "ref_type" ] ] ;
    rr:predicateObjectMap [ rr:predicate lila_corpus:hasCitLevel ;
                            rr:objectMap [ rr:column "cit_level" ; rr:datatype xsd:int ] ] ;
    rr:predicateObjectMap [ rr:predicate lila_corpus:hasRefValue ;
                            rr:objectMap [ rr:column "ref_value" ] ] ;
    rr:predicateObjectMap [ rr:predicate lila_corpus:first ;
                            rr:objectMap [ rr:column "first_iri" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate lila_corpus:last ;
                            rr:objectMap [ rr:column "last_iri" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate powla:next ;
                            rr:objectMap [ rr:column "next_iri" ; rr:termType rr:IRI ] ] .

