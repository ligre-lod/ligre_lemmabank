# PapyGreek–LiGre corpus (data/schema_papygreek.sql, loaded by data/load_papygreek.py).
# The corpus itself (powla:Corpus, powla:hasSubDocument) is described in ttl/ligre_void.ttl,
# which the endpoint serves as static facts.
corpus:DOCUMENT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT doc_id, title FROM papygreek.document""" ] ;
    rr:subjectMap         [ rr:template "__LIGRE_BASE_URL__/data/corpora/PapyGreek/id/corpus/{doc_id}" ;
                            rr:class    powla:Document ] ;
    rr:predicateObjectMap [ rr:predicate dc:title ;
                            rr:objectMap [ rr:column "title" ] ] .

