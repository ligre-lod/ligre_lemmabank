corpus:TOKEN
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:sqlQuery """SELECT doc_id, string_value, label, id_lemma, LPAD(CAST(position AS text), 7, '0') AS pos7, LPAD(CAST(next_position AS text), 7, '0') AS next7 FROM papygreek.token""" ] ;
    rr:subjectMap         [ rr:template "__LIGRE_BASE_URL__/data/corpora/PapyGreek/id/corpus/{doc_id}/{doc_id}_t_{pos7}" ;
                            rr:class    powla:Terminal ] ;
    rr:predicateObjectMap [ rr:predicate powla:hasStringValue ;
                            rr:objectMap [ rr:column "string_value" ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ;
