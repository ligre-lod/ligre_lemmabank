@prefix dc:          <http://purl.org/dc/elements/1.1/> .
@prefix dcterms:     <http://purl.org/dc/terms/> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rr:          <http://www.w3.org/ns/r2rml#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix powla:       <http://purl.org/powla/powla.owl#> .
@prefix lila:        <http://lila-erc.eu/ontologies/lila/> .
@prefix lila_corpus: <http://lila-erc.eu/ontologies/lila_corpora/> .
@prefix papygreek:   <__LIGRE_BASE_URL__/data/corpora/PapyGreek/mapping/> .

papygreek:CORPUS
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:tableName "papygreek_corpus" ] ;
    rr:subjectMap         [ rr:constant <__LIGRE_BASE_URL__/data/corpora/PapyGreek/id/corpus> ;
                            rr:class    powla:Corpus ] ;
    rr:predicateObjectMap [ rr:predicate dc:title ;
                            rr:objectMap [ rr:column "title" ] ] ;
    rr:predicateObjectMap [ rr:predicate dcterms:license ;
                            rr:objectMap [ rr:column "license" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate dcterms:source ;
                            rr:objectMap [ rr:column "source" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:seeAlso ;
                            rr:objectMap [ rr:column "see_also" ; rr:termType rr:IRI ] ] .

papygreek:CORPUS-DOCUMENT
    a                     rr:TriplesMap ;
    rr:logicalTable       [ rr:tableName "papygreek_document" ] ;
    rr:subjectMap         [ rr:constant <__LIGRE_BASE_URL__/data/corpora/PapyGreek/id/corpus> ] ;
    rr:predicateObjectMap [ rr:predicate powla:hasSubDocument ;
                            rr:objectMap [ rr:template "__LIGRE_BASE_URL__/data/corpora/PapyGreek/id/corpus/{id_document}" ] ] .

papygreek:DOCUMENT
    a                     rr:TriplesMap ;
