PREFIX lila: <http://lila-erc.eu/ontologies/lila/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?form (COUNT(?lemma) AS ?lemmas)
       (GROUP_CONCAT(CONCAT(STRAFTER(STR(?pos), "lila/"), COALESCE(CONCAT("/", STRAFTER(STR(?gender), "lila/")), "")); separator=", ") AS ?analyses)
WHERE {
  ?lemma a lila:Lemma ;
         rdfs:label ?form ;
         lila:hasPOS ?pos .
  OPTIONAL { ?lemma lila:hasGender ?gender }
}
GROUP BY ?form
HAVING (COUNT(?lemma) > 1)
ORDER BY DESC(?lemmas) ?form
LIMIT 20
